<Window x:Class="LuaToolsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamForge Studio" Height="760" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D13"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Inter, Roboto, sans-serif"
        Loaded="Window_Loaded"
        Opacity="0">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentColor1" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentColor2" Color="#06B6D4"/>
        
        <LinearGradientBrush x:Key="DynamicAccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="GradStop1" Color="#6366F1" Offset="0.0"/>
            <GradientStop x:Name="GradStop2" Color="#06B6D4" Offset="1.0"/>
        </LinearGradientBrush>

        <Storyboard x:Key="WindowFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ToastSuccessAnimation">
            <DoubleAnimation Storyboard.TargetName="ToastNotification" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="ToastNotification" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="ToastNotification" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" BeginTime="0:0:2.6" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="ToastNotification" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="30" BeginTime="0:0:2.6" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Фоновые неоновые сферы -->
        <Ellipse x:Name="BgGlow1" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0" Fill="#6366F1" Opacity="0.12" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="180"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="BgGlow2" Width="450" Height="450" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" Fill="#06B6D4" Opacity="0.1" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="180"/></Ellipse.Effect>
        </Ellipse>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Общая Шапка -->
            <Border Grid.Row="0" Background="#131722" CornerRadius="14" Padding="20,12" Margin="0,0,0,16" BorderBrush="#1F2637" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource DynamicAccentGrad}" Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGreeting" Text="Добро пожаловать! 🚀" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="SteamForge Studio • Smart Manifest Engine" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопки перехода: Настройки / Назад + Рестарт Steam -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnNavSettings" Content="⚙️ Настройки" Click="BtnNavSettings_Click"
                                Background="#182030" Foreground="#F59E0B" BorderBrush="#223049" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="BtnNavBack" Content="⬅️ К генератору" Click="BtnNavBack_Click" Visibility="Collapsed"
                                Background="#182030" Foreground="#10B981" BorderBrush="#223049" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="BtnRestartSteam" Content="🔄 Рестарт Steam" Click="BtnRestartSteam_Click"
                                Background="#182030" Foreground="#38BDF8" BorderBrush="#223049" BorderThickness="1"
                                Padding="14,8" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЭКРАН 1: Основной Генератор -->
            <Grid x:Name="ViewGenerator" Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Поиск и Выбор -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#131722" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#1F2637" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGameName" Grid.Column="0" Height="42" Background="#0C0F17" Foreground="#F8FAFC" 
                                     BorderBrush="#252D40" BorderThickness="1" Padding="14,0" VerticalContentAlignment="Center" 
                                     FontSize="13" Margin="0,0,10,0" KeyDown="TxtGameName_KeyDown" Text="Dying Light">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>
                            <Button x:Name="BtnSearch" Grid.Column="1" Click="BtnSearch_Click"
                                    Height="42" Background="{StaticResource DynamicAccentGrad}" Foreground="#FFFFFF" FontWeight="Bold" 
                                    BorderThickness="0" Padding="18,0" Cursor="Hand" FontSize="12">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <TextBlock Text="🔍 Найти"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#131722" CornerRadius="12" Padding="14" BorderBrush="#1F2637" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="РЕЗУЛЬТАТЫ ПОИСКА (ВЫБЕРИТЕ ИГРУ)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>

                            <ListBox x:Name="LstSearchResults" Grid.Row="1" Background="#0C0F17" BorderBrush="#1F2637" BorderThickness="1"
                                     Foreground="#E2E8F0" SelectionChanged="LstSearchResults_SelectionChanged" Margin="0,0,0,10">
                                <ListBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <TextBlock Text="🎮 " VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#F1F5F9"/>
                                            <TextBlock Text=" (AppID: " Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Id}" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text=")" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True" Background="#0C0F17" BorderBrush="#1F2637" BorderThickness="1">
                                <Image x:Name="ImgCover" Stretch="UniformToFill" 
                                       Source="https://cdn.cloudflare.steamstatic.com/steam/apps/239140/header.jpg"/>
                            </Border>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock x:Name="TxtSelectedTitle" Text="Dying Light" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtSelectedAppId" Text="AppID: 239140" Foreground="#38BDF8" FontSize="12" Margin="0,2,0,8"/>
                                <Button x:Name="BtnApplyManifest" Content="⚡ Сгенерировать Lua манифест" Click="BtnApplyManifest_Click"
                                        Background="{StaticResource DynamicAccentGrad}" Foreground="#FFFFFF" FontWeight="Bold" Height="38" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Правая колонка: Журнал логов -->
                <Border Grid.Column="1" Background="#131722" CornerRadius="14" Padding="16" BorderBrush="#1F2637" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="АКТИВНОСТЬ И ЖУРНАЛ СИНХРОНИЗАЦИИ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="● Готов" HorizontalAlignment="Right" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#0C0F17" CornerRadius="10" Padding="12" BorderBrush="#1A2234" BorderThickness="1">
                            <ListBox x:Name="LstLogs" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                                     FontFamily="Consolas, Cascadia Code, monospace" FontSize="12" Padding="0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ЭКРАН 2: Отдельное окно Настроек -->
            <Border x:Name="ViewSettings" Grid.Row="1" Background="#131722" CornerRadius="14" Padding="28" BorderBrush="#1F2637" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        
                        <!-- Раздел 1: Темы -->
                        <TextBlock Text="ПАЛИТРА И ОФОРМЛЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14"/>
                        <Border Background="#0C0F17" CornerRadius="12" Padding="18" Margin="0,0,0,24" BorderBrush="#1F2637" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Выберите стиль акцентного неонового свечения интерфейса:" Foreground="#CBD5E1" Margin="0,0,0,14" FontSize="13"/>
                                <WrapPanel>
                                    <Button Content="🟣 Cyber Violet" Click="ThemeViolet_Click" Background="#4F46E5" Foreground="#FFFFFF" Padding="16,9" Margin="0,0,10,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🔵 Neon Blue" Click="ThemeBlue_Click" Background="#0284C7" Foreground="#FFFFFF" Padding="16,9" Margin="0,0,10,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🟢 Matrix Green" Click="ThemeGreen_Click" Background="#059669" Foreground="#FFFFFF" Padding="16,9" Margin="0,0,10,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🟠 Sunset Gold" Click="ThemeSunset_Click" Background="#D97706" Foreground="#FFFFFF" Padding="16,9" Margin="0,0,10,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Раздел 2: Ссылки автора -->
                        <TextBlock Text="ССЫЛКИ И РЕСУРСЫ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14"/>
                        <Border Background="#0C0F17" CornerRadius="12" Padding="18" Margin="0,0,0,24" BorderBrush="#1F2637" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Официальные страницы разработчика:" Foreground="#CBD5E1" Margin="0,0,0,14" FontSize="13"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🌐 Сайт moskvol.github.io" Click="OpenWebsite_Click"
                                            Background="#182030" Foreground="#38BDF8" BorderBrush="#223049" BorderThickness="1"
                                            Padding="18,10" Margin="0,0,14,0" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="🐱 GitHub Профиль" Click="OpenGithub_Click"
                                            Background="#182030" Foreground="#E2E8F0" BorderBrush="#223049" BorderThickness="1"
                                            Padding="18,10" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Раздел 3: Системная инфа -->
                        <TextBlock Text="О СИСТЕМЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14"/>
                        <Border Background="#0C0F17" CornerRadius="12" Padding="18" BorderBrush="#1F2637" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SteamForge Studio v2.5" FontWeight="Bold" Foreground="#FFFFFF" FontSize="14"/>
                                <TextBlock Text="Движок автоматической генерации Lua-манифестов для Steam." Foreground="#64748B" Margin="0,4,0,14" FontSize="12"/>
                                <Button Content="⬅️ Вернуться к генератору" Click="BtnNavBack_Click"
                                        Background="{StaticResource DynamicAccentGrad}" Foreground="#FFFFFF" FontWeight="Bold"
                                        Padding="20,10" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastNotification"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,36,36"
                Background="#0F172A"
                BorderBrush="#10B981"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="18,12"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#10B981" BlurRadius="25" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="30"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ToastText" Text="Конфиг успешно активирован!" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>